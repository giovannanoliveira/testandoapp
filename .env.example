# Copie para .env (na raiz do projeto) e preencha. Nunca faça commit do .env.

# --- Banco de dados (PostgreSQL) ---
# Supabase: Project Settings → Database → Connection string (URI).
# Para Supabase, acrescente ?sslmode=require&uselibpqcompat=true ao final da URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vizinhanca

# --- Autenticação (Clerk, login com Google) ---
# dashboard.clerk.com → API Keys. Sem CLERK_SECRET_KEY o login Google fica desativado.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Pagamentos (Stripe) ---
# dashboard.stripe.com → Developers → API keys (use a chave de teste sk_test_ primeiro).
STRIPE_SECRET_KEY=sk_test_xxx
# Segredo do endpoint de webhook (whsec_...) apontando para <PUBLIC_API_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Opcional: ID do preço. Se vazio, a API procura o produto criado por `pnpm --filter @workspace/scripts run seed:stripe`.
STRIPE_PRICE_ID=

# --- IA (opcional) ---
OPENAI_API_KEY=

# --- URLs ---
PORT=5000
# URL pública da API (usada nos redirects da Stripe). Se vazio, usa o host da requisição.
PUBLIC_API_URL=http://localhost:5000
# URL do app web, para o botão "Voltar ao aplicativo" após o pagamento. Se vazio, usa o deep link mobile://
APP_URL=http://localhost:8081
# Origens permitidas no CORS, separadas por vírgula. Se vazio, aceita qualquer origem.
CORS_ORIGINS=
